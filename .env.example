# ── Local dev only (VITE_ keys are NOT used in production) ──
# Provider priority: primary → fallback on 429/503/529
# Options: gemini | groq  (default: gemini)
VITE_LLM_PROVIDER=gemini
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=

# ── Vercel environment variables (set in dashboard, NOT here) ──
# Fallback chain: LLM_PROVIDER (primary) → other configured providers → OpenRouter
# Options: groq | gemini  (default: groq — more generous free tier)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=   # optional third fallback (free models via openrouter.ai)
# LLM_PROVIDER=groq
